---
import CategoryGrid from "../components/sections/CategoryGrid.astro";
import BrandIdea from "../components/sections/BrandIdea.astro";
import ContactCta from "../components/sections/ContactCta.astro";
import FeaturedProducts from "../components/sections/FeaturedProducts.astro";
import Hero from "../components/sections/Hero.astro";
import SellingPoints from "../components/sections/SellingPoints.astro";
import company from "../data/company.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";
---

<BaseLayout
  title={makePageTitle()}
  description={`${company.name}：专业摩托车手机支架与车载配件，产品覆盖骑行、车载、桌面与笔记本五个类目，支持批量询价。`}
>
  <Hero />
  <SellingPoints />
  <CategoryGrid />
  <FeaturedProducts />
  <BrandIdea />
  <ContactCta />
</BaseLayout>

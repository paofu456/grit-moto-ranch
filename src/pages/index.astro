---
import CategoryGrid from "../components/sections/CategoryGrid.astro";
import CompanyIntro from "../components/sections/CompanyIntro.astro";
import ContactCta from "../components/sections/ContactCta.astro";
import FeaturedProducts from "../components/sections/FeaturedProducts.astro";
import Hero from "../components/sections/Hero.astro";
import company from "../data/company.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";
---

<BaseLayout
  title={makePageTitle()}
  description={`${company.name}：骑行、车载、桌面与笔记本手机支架共 5 个类目，支持批量询价。`}
>
  <Hero />
  <CategoryGrid />
  <CompanyIntro />
  <FeaturedProducts />
  <ContactCta />
</BaseLayout>

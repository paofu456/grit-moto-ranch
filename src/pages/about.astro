---
import ContactCta from "../components/sections/ContactCta.astro";
import Container from "../components/ui/Container.astro";
import company from "../data/company.json";
import { copy } from "../data/copy";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../lib/categories";
import { getPublishedProducts } from "../lib/products";
import { makePageTitle } from "../lib/seo";

const products = await getPublishedProducts();
const counts = CATEGORIES.map((category) => ({
  ...category,
  count: products.filter((product) => product.data.category === category.key).length,
}));
---

<BaseLayout
  title={makePageTitle("品牌故事")}
  description={`${company.name} 的品牌理念与产品类目介绍。`}
>
  <section class="relative overflow-hidden bg-[var(--color-ink)] py-20 text-white sm:py-28">
    <div class="absolute inset-0 opacity-20" aria-hidden="true" style="background-image: radial-gradient(circle at 85% 30%, var(--color-accent) 0, transparent 32%);"></div>
    <Container class="relative grid items-center gap-12 lg:grid-cols-[1.1fr_.9fr] lg:gap-16">
      <div>
        <p class="mb-5 text-xs font-extrabold tracking-[0.24em] text-[var(--color-accent)]">品牌故事</p>
        <h1 class="max-w-3xl text-4xl font-black leading-[1.12] sm:text-6xl">{company.name}</h1>
        <p class="mt-7 max-w-2xl text-xl leading-9 text-white/70">{copy.brandIdea}</p>
      </div>
      <div class="lg:justify-self-end">
        <img
          src={company.logoLockupOnDark}
          alt={`${company.brandEn} logo`}
          width="440"
          height="344"
          class="h-auto w-52 sm:w-72"
        />
      </div>
    </Container>
  </section>

  <section class="py-24 sm:py-32">
    <Container>
      <p class="text-xs font-bold tracking-[0.24em] text-[var(--color-accent)]">我们做什么</p>
      <h2 class="mt-4 max-w-3xl text-3xl font-black leading-tight text-[var(--color-ink)] sm:text-4xl">
        {CATEGORIES.length} 个类目，{products.length} 款在售型号
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-9 text-[var(--color-muted)]">{company.description}</p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {counts.map((category) => (
          <a href={`/products/#${category.key}`} class="border border-[var(--color-line)] bg-white p-7 transition hover:border-[var(--color-accent)] hover:shadow-[var(--shadow-card)]">
            <h3 class="text-xl font-black text-[var(--color-ink)]">{category.label}</h3>
            <p class="mt-2 text-sm font-bold text-[var(--color-muted)]">{category.count} 款</p>
            <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">{category.blurb}</p>
          </a>
        ))}
      </div>
      <p class="mt-10 max-w-3xl border-l-2 border-[var(--color-line)] pl-4 text-sm leading-7 text-[var(--color-muted)]">
        公司成立时间、所在地与产能等资料待确认后补充，本页不使用未经确认的表述。
      </p>
    </Container>
  </section>

  <ContactCta />
</BaseLayout>

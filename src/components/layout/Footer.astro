---
import company from "../../data/company.json";
import { siteConfig } from "../../../site.config";
import Container from "../ui/Container.astro";

const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-ink)] text-white">
  <Container class="grid gap-12 py-16 md:grid-cols-[1.6fr_1fr_1fr]">
    <div>
      {company.logoOnDark
        ? <img src={company.logoOnDark} alt={`${company.brandEn} logo`} width="220" height="76" class="h-11 w-auto" />
        : <span class="block text-lg font-black tracking-tight text-white">{company.name}</span>}
      <p class="mt-6 max-w-md text-sm leading-7 text-white/65">{company.description}</p>
    </div>
    <div>
      <h2 class="text-sm font-bold tracking-[0.16em] text-[var(--color-accent)]">网站导航</h2>
      <ul class="mt-5 space-y-3 text-sm text-white/75">
        {siteConfig.navigation.map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold tracking-[0.16em] text-[var(--color-accent)]">联系方式</h2>
      <ul class="mt-5 space-y-3 text-sm text-white/75">
        {company.email && <li><a class="hover:text-white" href={`mailto:${company.email}`}>{company.email}</a></li>}
        {company.phone && <li><a class="hover:text-white" href={`tel:${company.phone.replace(/\s/g, "")}`}>{company.phone}</a></li>}
        {company.whatsapp && <li><a class="hover:text-white" href={`https://wa.me/${company.whatsapp.replace(/[^\d]/g, "")}`}>WhatsApp {company.whatsapp}</a></li>}
        {company.address && <li>{company.address}</li>}
        {!company.email && !company.phone && !company.whatsapp && <li>联系方式待补充</li>}
      </ul>
    </div>
  </Container>
  <div class="border-t border-white/10">
    <Container class="flex flex-col gap-2 py-6 text-xs text-white/50 sm:flex-row sm:justify-between">
      <p>© {year} {company.name}</p>
      <p>{company.location}</p>
    </Container>
  </div>
</footer>

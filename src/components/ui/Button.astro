---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "light" | "text";
  class?: string;
}

const { href, variant = "primary", class: className = "" } = Astro.props;
const styles = {
  primary: "bg-[var(--color-primary)] text-white hover:bg-[var(--color-accent)]",
  secondary: "border border-[var(--color-line)] bg-white text-[var(--color-ink)] hover:border-[var(--color-primary)]",
  // For use on dark sections: white surface, high-contrast label.
  light: "bg-white text-[var(--color-ink)] hover:bg-[var(--color-accent)] hover:text-white",
  text: "text-[var(--color-primary)] hover:text-[var(--color-accent)]",
};
---

<a
  href={href}
  class:list={[
    "inline-flex min-h-12 items-center justify-center rounded-full px-6 py-3 text-sm font-bold transition-colors",
    styles[variant],
    className,
  ]}
>
  <slot />
</a>

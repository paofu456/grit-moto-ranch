---
import company from "../../data/company.json";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const hasFacts = Boolean(company.founded || company.location);
---

<section class="py-24 sm:py-32">
  <Container class="grid items-start gap-12 lg:grid-cols-[1fr_.85fr] lg:gap-20">
    <SectionHeading
      eyebrow="主营产品"
      title="摩托车手机支架"
      description="型号、规格与图片资料补齐后，这里会替换成可直接对比的参数说明。"
    />
    <div class="border border-[var(--color-line)] bg-white p-8 shadow-[var(--shadow-card)] sm:p-10">
      <p class="text-lg leading-8 text-[var(--color-muted)]">{company.description}</p>
      {hasFacts && (
        <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-[var(--color-line)] pt-8">
          {company.founded && (
            <div>
              <dt class="text-xs font-bold tracking-[0.14em] text-[var(--color-muted)]">成立时间</dt>
              <dd class="mt-2 font-extrabold text-[var(--color-ink)]">{company.founded}</dd>
            </div>
          )}
          {company.location && (
            <div>
              <dt class="text-xs font-bold tracking-[0.14em] text-[var(--color-muted)]">所在地</dt>
              <dd class="mt-2 font-extrabold text-[var(--color-ink)]">{company.location}</dd>
            </div>
          )}
        </dl>
      )}
      <Button href="/about/" variant="text" class="mt-7 px-0">了解我们 →</Button>
    </div>
  </Container>
</section>

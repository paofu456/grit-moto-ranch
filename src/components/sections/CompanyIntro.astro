---
import company from "../../data/company.json";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { CATEGORIES } from "../../lib/categories";
import { getPublishedProducts } from "../../lib/products";

const products = await getPublishedProducts();
const counts = CATEGORIES.map((category) => ({
  ...category,
  count: products.filter((product) => product.data.category === category.key).length,
}));
---

<section class="py-24 sm:py-32">
  <Container class="grid items-start gap-12 lg:grid-cols-[1fr_.85fr] lg:gap-20">
    <SectionHeading
      eyebrow="主营产品"
      title={`${CATEGORIES.length} 个类目，${products.length} 款产品。`}
      description="骑行、桌面、车载与笔记本支架逐条列出型号与颜色；价格不公开，按数量询价。"
    />
    <div class="border border-[var(--color-line)] bg-white p-8 shadow-[var(--shadow-card)] sm:p-10">
      <p class="text-lg leading-8 text-[var(--color-muted)]">{company.description}</p>
      <ul class="mt-8 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {counts.map((category) => (
          <li class="flex items-center justify-between gap-4 py-4">
            <a href={`/products/#${category.key}`} class="text-base font-bold text-[var(--color-ink)] hover:text-[var(--color-accent)]">
              {category.label}
            </a>
            <span class="text-sm font-bold text-[var(--color-muted)]">{category.count} 款</span>
          </li>
        ))}
      </ul>
      <Button href="/about/" variant="text" class="mt-7 px-0">了解我们 →</Button>
    </div>
  </Container>
</section>

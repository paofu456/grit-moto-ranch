---
import { copy } from "../../data/copy";
import Container from "../ui/Container.astro";
---

<section class="border-b border-[var(--color-line)] bg-white py-20 sm:py-24">
  <Container>
    <p class="text-xs font-bold tracking-[0.24em] text-[var(--color-accent)]">核心卖点</p>
    <div class="mt-10 grid gap-px bg-[var(--color-line)] sm:grid-cols-3">
      {copy.sellingPoints.map((point, index) => (
        <div class="bg-white px-0 py-8 sm:px-8 sm:py-0">
          <p class="text-sm font-black text-[var(--color-accent)]">{String(index + 1).padStart(2, "0")}</p>
          <h2 class="mt-4 text-2xl font-black text-[var(--color-ink)]">{point.title}</h2>
          <p class="mt-3 text-base leading-8 text-[var(--color-muted)]">{point.text}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

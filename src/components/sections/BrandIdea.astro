---
import company from "../../data/company.json";
import { copy } from "../../data/copy";
import Container from "../ui/Container.astro";

const phoneHref = company.phone.replace(/\s/g, "");
---

<section class="bg-[var(--color-ink)] py-20 text-white sm:py-24">
  <Container class="grid items-center gap-12 lg:grid-cols-[1.2fr_.8fr] lg:gap-20">
    <div>
      <p class="text-xs font-bold tracking-[0.24em] text-[var(--color-accent)]">品牌理念</p>
      <p class="mt-6 text-2xl font-black leading-relaxed sm:text-4xl sm:leading-snug">{copy.brandIdea}</p>
      <div class="mt-8 flex flex-col gap-2 text-sm text-white/70 sm:flex-row sm:items-center sm:gap-6">
        {company.phone && (
          <a href={`tel:${phoneHref}`} class="font-bold text-white hover:text-[var(--color-accent)]">咨询电话 {company.phone}</a>
        )}
        {company.email && (
          <a href={`mailto:${company.email}`} class="break-all hover:text-[var(--color-accent)]">邮箱 {company.email}</a>
        )}
      </div>
    </div>
    <div class="lg:justify-self-end">
      <img
        src={company.logoLockupOnDark}
        alt={`${company.brandEn} logo`}
        width="440"
        height="344"
        class="h-auto w-56 sm:w-64"
      />
    </div>
  </Container>
</section>
